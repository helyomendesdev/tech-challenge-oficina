            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"EXECUCAO\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ordens-servico/6/",
