              "path": ["api", "v1", "ordens-servico", "6", ""]
            },
            "description": "Ao mudar para EXECUCAO, o campo `data_inicio_execucao` é preenchido automaticamente."
          }
        },
        {
          "name": "Avançar Status → FINALIZADA",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
