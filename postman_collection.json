{
  "info": {
    "name": "Oficina Mecânica API",
    "_postman_id": "oficina-api-v1",
    "description": "Collection completa para testar a API do Tech Challenge Fase 1 - FIAP.\n\n**Como usar:**\n1. Importe também o arquivo `postman_environment.json`\n2. Selecione o environment \"Oficina Local\"\n3. Execute \"Obter Token\" primeiro — o token é salvo automaticamente\n4. Todas as demais requisições já usam o token automaticamente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [],
  "item": [
    {
      "name": "Autenticação",
      "description": "Endpoints JWT para obter e renovar tokens de acesso.",
      "item": [
        {
          "name": "Obter Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('access_token', json.access);",
                  "    pm.environment.set('refresh_token', json.refresh);",
                  "    pm.test('Token obtido com sucesso', () => pm.response.to.have.status(200));",
                  "    console.log('✅ access_token salvo no environment');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", ""]
            },
            "description": "Autentica com usuário/senha e salva o `access_token` e `refresh_token` automaticamente no environment."
          }
        },
        {
          "name": "Renovar Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('access_token', json.access);",
                  "    pm.test('Token renovado com sucesso', () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "token", "refresh", ""]
            },
            "description": "Usa o refresh_token para obter um novo access_token sem precisar reautenticar."
          }
        }
      ]
    },
