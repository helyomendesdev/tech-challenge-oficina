# ============================================================
#  .env.example — Variáveis de Ambiente da Oficina API
# ============================================================
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NÃO deve ser versionado (já está no .gitignore).
#
#   cp .env.example .env
# ============================================================

# Django
DJANGO_SECRET_KEY=substitua-por-uma-chave-forte-e-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False

# PostgreSQL
POSTGRES_DB=oficina_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=substitua-por-senha-forte
DB_HOST=db

# CORS (origens permitidas separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Simulador de orçamento
WEBHOOK_ORCAMENTO_URL=http://localhost:8000/api/v1/orcamentos/notificacoes/

# ------------------------------------------------------------
# Observabilidade (Fase 3)
# ------------------------------------------------------------
# Identificação do serviço. SERVICE_ENVIRONMENT é filtro obrigatório em todo
# widget e alerta — ver §4 de docs/fase3/observabilidade/README.md.
SERVICE_NAME=oficina-api
SERVICE_ENVIRONMENT=homologacao
SERVICE_VERSION=1.0.0

# Salt do hash de cliente.ref. Precisa ser diferente por ambiente: com salt
# igual, o mesmo CPF gera o mesmo hash em homologação e produção, e o
# pseudônimo deixa de proteger o que deveria.
OBSERVABILIDADE_SALT=substitua-por-valor-aleatorio-por-ambiente

# New Relic. DEIXE VAZIO para rodar sem APM — a aplicação sobe normalmente e o
# entrypoint avisa em qual modo subiu. Só preencha se tiver conta própria.
# A chave é do tipo "Ingest - License", não a User Key.
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=oficina-api-hml
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
# Assimétrico de propósito. LOCAL: true — não há coletor no docker compose, e sem
# isto o log não sai da máquina e o painel de integração fica vazio sem explicar.
# NO CLUSTER: false — quem recolhe o stdout é a integração de Kubernetes, e com os
# dois ligados a mesma linha chega duas vezes.
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=true
